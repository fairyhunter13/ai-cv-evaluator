#!/usr/bin/env bash
# Pre-push gate for the knowledge/ bundle.
#
# The pre-commit hook reaches the checker only through `make lint-all`, which exits 0 when make
# is absent and is skipped outright by SKIP_PRE_COMMIT_LINT=1. That is the right shape for a
# fast local loop and the wrong shape for a gate, so this calls the checker directly and has
# no escape hatch but --no-verify.
#
# Skip with:  git push --no-verify
#
# Install:    git config core.hooksPath .githooks
# Uninstall:  git config --unset core.hooksPath
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [[ -d "$REPO_ROOT/knowledge" ]]; then
  OKF="$REPO_ROOT/bin/okfrules"
  if [ ! -x "$OKF" ]; then
    OKF="$(command -v okfrules 2>/dev/null)"
  fi
  if [ -z "$OKF" ] || [ ! -x "$OKF" ]; then
    echo "[pre-push] ✗ okfrules is in neither bin/ nor PATH — knowledge/ cannot be checked"
    echo "[pre-push]   make tools    # or: go install github.com/fairyhunter13/okf/cmd/okfrules@v0.6.1"
    exit 1
  fi
  # -Werror, matching lint-knowledge: a broken link is a *warning*, which plain check prints
  # and then exits 0 on.
  if ! "$OKF" check -Werror "$REPO_ROOT/knowledge"; then
    echo "[pre-push] ✗ knowledge/ is not a conformant OKF bundle — push blocked"
    exit 1
  fi
fi

exit 0
